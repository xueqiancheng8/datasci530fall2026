   "source": [
    "#  Write your own Code\n",
    "# Search for all divs whose class is exactly \"form-group\"\n",
    "list_formgroup = driver.find_elements('xpath', '//div[@class = \"form-group\"]')\n",
    "\n",
    "# Count elements found\n",
    "print(len(list_formgroup))\n",
    "\n",
    "# Store the first line of each element in a diagnostics file\n",
    "with open('html_files/diagnose_formgroup.html', 'w') as file:\n",
    "    for i in range(len(list_formgroup)):\n",
    "        html_code  = list_formgroup[i].get_attribute(\"innerHTML\")\n",
    "        parse_code = BeautifulSoup(html_code, \"html.parser\").prettify()\n",
    "        lines = parse_code.splitlines()\n",
    "        if len(lines) > 0:\n",
    "            file.write(lines[0] + \"\\n\")"
   ]
  }
